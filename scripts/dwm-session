#!/usr/bin/env python3
"""Save/restore the set of running GUI apps across a dwm restart.

save    - snapshot every managed window's command line + cwd
restore - relaunch them
loop    - save every 60s (so a hard reboot loses at most a minute)
"""
import json, os, re, subprocess, sys, time

STATE = os.path.expanduser("~/.local/state/dwm-session.json")


def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout


def snapshot():
    ids = re.findall(r"0x[0-9a-f]+", sh("xprop", "-root", "_NET_CLIENT_LIST"))
    seen, out = set(), []
    for wid in ids:
        m = re.search(r"_NET_WM_PID\(CARDINAL\) = (\d+)", sh("xprop", "-id", wid, "_NET_WM_PID"))
        if not m or m.group(1) in seen:
            continue
        pid = m.group(1)
        seen.add(pid)
        try:
            cmd = open(f"/proc/{pid}/cmdline", "rb").read().decode().split("\0")[:-1]
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            continue
        if cmd:
            out.append({"cmd": cmd, "cwd": cwd})
    return out


def main(mode):
    if mode == "restore":
        for app in json.load(open(STATE)):
            cwd = app["cwd"] if os.path.isdir(app["cwd"]) else None
            subprocess.Popen(app["cmd"], cwd=cwd, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.3)  # ponytail: crude stagger, drop if apps cope
        return
    while True:
        apps = snapshot()
        if apps:  # never overwrite a good session with an empty one
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            tmp = STATE + ".tmp"
            json.dump(apps, open(tmp, "w"), indent=1)
            os.replace(tmp, STATE)
        if mode != "loop":
            return
        time.sleep(60)


main(sys.argv[1] if len(sys.argv) > 1 else "save")
